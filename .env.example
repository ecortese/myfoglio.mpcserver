# ─────────────────────────────────────────────────────────────
# myfoglio MCP Server — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Base URL of the myfoglio API  (default: production)
# Override this to target dev / stage / preprod environments.
MYFOGLIO_BASE_URL=https://api.myfoglio.com

# ****** used to authenticate every API call.
# Required — the server will refuse to start without it.
MYFOGLIO_TOKEN=your_bearer_token_here

# API version used to build the Accept header.
# Default: 1
API_VERSION=1

# Transport mode: "stdio" (local / Claude Desktop) or "http" (remote server)
# Default: stdio
MCP_TRANSPORT=stdio

# HTTP port — only used when MCP_TRANSPORT=http
# Default: 3000
MCP_HTTP_PORT=3000
