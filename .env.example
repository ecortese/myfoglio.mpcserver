# ─────────────────────────────────────────────────────────────
# myfoglio MCP Server — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Base URL of the MyFoglio API (default: production)
# Override this to target dev / stage / preprod environments.
MYFOGLIO_BASE_URL=https://api.myfoglio.com

# Preferred authentication model for MyFoglio.
# Use your API key and secret pair. The server uses these credentials
# to obtain an OAuth access token via the client_credentials flow.
MYFOGLIO_API_KEY=your_api_key
MYFOGLIO_API_SECRET=your_api_secret

# Optional refresh token reused across restarts.
# If omitted, the server obtains a fresh access token with the API key/secret.
MYFOGLIO_REFRESH_TOKEN=your_refresh_token

# API version used to build the Accept header.
# Default: 2
API_VERSION=2

# Transport mode: "stdio" (local / Claude Desktop) or "http" (remote server)
# Default: stdio
MCP_TRANSPORT=stdio

# HTTP port — only used when MCP_TRANSPORT=http
# Default: 3000
MCP_HTTP_PORT=3000
