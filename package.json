{
  "name": "myfoglio-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing myfoglio REST APIs as AI-agent tools",
  "main": "dist/index.js",
  "bin": {
    "myfoglio-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:http": "MCP_TRANSPORT=http ts-node src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["mcp", "myfoglio", "ai", "model-context-protocol"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
